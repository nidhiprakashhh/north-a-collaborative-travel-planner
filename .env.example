# Copy this file to .env and fill in real values before running docker-compose up.
# .env is gitignored — never commit real secrets.

# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin allowed to open Socket.io connections and hit the REST API from a
# browser. The static test page is served same-origin, so this only matters
# once the real Vite frontend (default port 5173) exists.
CORS_ORIGIN=http://localhost:5173

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- PostgreSQL ----
POSTGRES_USER=north_user
POSTGRES_PASSWORD=north_password
POSTGRES_DB=north_db
# Hostname is the docker-compose service name, not localhost — the api
# container reaches postgres over the compose network by service name.
DATABASE_URL=postgresql://north_user:north_password@postgres:5432/north_db?schema=public

# ---- MongoDB ----
MONGO_URI=mongodb://mongodb:27017/north_preferences

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- LLM (Groq) ----
# Read by the Go synthesis worker (see /worker), not the api service — the
# api process hands synthesis jobs off over Redis and never holds this key.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional worker tuning, all have sane defaults if left unset:
# WORKER_POOL_SIZE=4        # max concurrent Groq calls
# GROQ_TIMEOUT_SECONDS=20   # per-attempt HTTP timeout
# GROQ_MAX_ATTEMPTS=3       # retries on timeout/429/5xx/invalid JSON
