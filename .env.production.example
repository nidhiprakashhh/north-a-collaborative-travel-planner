# Copy to .env.production on the EC2 host and fill in real values.
# .env.production is gitignored — never commit real secrets.
#
# IMPORTANT: docker-compose.prod.yml substitutes ${VARS} into the compose
# file itself (e.g. POSTGRES_USER, DOMAIN), but the *_URL connection strings
# below are passed to the api container verbatim via env_file — compose does
# NOT expand ${...} inside them. If you change POSTGRES_PASSWORD, MONGO_ROOT_*,
# or REDIS_PASSWORD below, you must manually update DATABASE_URL / MONGO_URI /
# REDIS_URL to match, or the api container won't be able to authenticate.

# ---- Domain / TLS ----
# Used by nginx (server_name + cert path) and deploy/init-letsencrypt.sh.
DOMAIN=your-domain.example.com
CERTBOT_EMAIL=you@example.com

# ---- Server ----
NODE_ENV=production
PORT=4000
# Same-origin in production (nginx serves the frontend and proxies /api and
# /socket.io from that same domain), so this exists only as a fallback for
# any request that somehow doesn't go through nginx.
CORS_ORIGIN=https://your-domain.example.com

# Baked into the frontend bundle at image build time (Vite env vars are
# compile-time, not runtime) — see nginx/Dockerfile's VITE_API_URL build arg.
# Same-origin, so this should just be the public domain.
VITE_API_URL=https://your-domain.example.com

# ---- JWT ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- PostgreSQL ----
POSTGRES_USER=north_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=north_db
DATABASE_URL=postgresql://north_user:replace_with_a_strong_password@postgres:5432/north_db?schema=public

# ---- MongoDB ----
# Prod runs mongod with --auth (dev doesn't) — see docker-compose.prod.yml.
MONGO_ROOT_USERNAME=north_mongo_admin
MONGO_ROOT_PASSWORD=replace_with_a_strong_password
MONGO_URI=mongodb://north_mongo_admin:replace_with_a_strong_password@mongodb:27017/north_preferences?authSource=admin

# ---- Redis ----
REDIS_PASSWORD=replace_with_a_strong_password
REDIS_URL=redis://:replace_with_a_strong_password@redis:6379

# ---- LLM (Groq) ----
# Read by the Go synthesis worker (see /worker), not the api service — the
# api process hands synthesis jobs off over Redis and never holds this key.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional worker tuning, all have sane defaults if left unset:
# WORKER_POOL_SIZE=4        # max concurrent Groq calls
# GROQ_TIMEOUT_SECONDS=20   # per-attempt HTTP timeout
# GROQ_MAX_ATTEMPTS=3       # retries on timeout/429/5xx/invalid JSON
